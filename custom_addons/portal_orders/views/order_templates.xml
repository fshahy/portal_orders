<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_breadcrumbs" name="Portal Orders Breadcrumbs" inherit_id="portal.portal_breadcrumbs" priority="10">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'portal_orders'" t-attf-class="breadcrumb-item #{'active' if not portal_order else ''}">
                <a t-if="portal_order" t-attf-href="/my/portal_orders?{{ keep_query() }}">Portal Orders</a>
                <t t-else="">Portal Orders</t>
            </li>
            <!-- not named `order`: purchase adds its own crumbs for that variable -->
            <li t-if="page_name == 'portal_orders' and portal_order" class="breadcrumb-item active text-truncate">
                <span t-field="portal_order.name"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_orders" name="My Portal Orders">
        <!-- values must be t-call attributes: a t-set in the body does not
             reach the called template -->
        <t t-call="portal.portal_layout" breadcrumbs_searchbar="True">

            <t t-call="portal.portal_searchbar" breadcrumbs_searchbar="True" title.translate="Portal Orders">
                <button t-if="not is_manager" type="button" class="btn btn-success"
                        data-bs-toggle="modal" data-bs-target="#o_portal_orders_new_order_modal">
                    <i class="fa fa-plus me-1"/>Create New
                </button>
            </t>

            <div t-if="not is_manager" id="o_portal_orders_new_order_modal" class="modal fade o_portal_orders_new_order" tabindex="-1" role="dialog">
                <div class="modal-dialog">
                    <form class="modal-content">
                        <header class="modal-header">
                            <h4 class="modal-title">New Portal Order</h4>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                        </header>
                        <main class="modal-body">
                            <div class="mb-3">
                                <label class="form-label" for="o_portal_orders_product">Product <span class="text-danger">*</span></label>
                                <select id="o_portal_orders_product" class="form-select o_portal_orders_product" required="required"/>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="o_portal_orders_amount">Amount <span class="text-danger">*</span></label>
                                <input id="o_portal_orders_amount" type="number" min="1" class="form-control o_portal_orders_amount" required="required"/>
                                <div class="form-text o_portal_orders_amount_help"/>
                            </div>
                            <div class="mb-3">
                                <span class="form-label d-block">Vendors <span class="text-danger">*</span></span>
                                <div class="o_portal_orders_suppliers"/>
                            </div>
                            <p class="o_portal_orders_tax_rate text-muted"/>
                            <div class="o_portal_orders_totals mb-3"/>
                            <div class="mb-3">
                                <label class="form-label" for="o_portal_orders_signature">Signed request (PDF file, max 5MB) <span class="text-danger">*</span></label>
                                <input id="o_portal_orders_signature" accept=".pdf,application/pdf" type="file" class="form-control o_portal_orders_signature" required="required"/>
                            </div>
                        </main>
                        <footer class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary o_portal_orders_confirm">Confirm</button>
                        </footer>
                    </form>
                </div>
            </div>

            <div t-if="not orders" class="alert alert-warning" role="alert">
                No orders
            </div>

            <t t-if="orders" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>Order Number</th>
                        <th t-if="is_manager">Employee</th>
                        <th>Product</th>
                        <th class="text-end">Amount</th>
                        <th>Creation Date</th>
                        <th class="text-end">No. of Attachments</th>
                        <th>State</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="orders" t-as="order">
                        <td><a t-attf-href="/my/portal_orders/#{order.id}" t-field="order.name"/></td>
                        <td t-if="is_manager"><span t-field="order.partner_id.name"/></td>
                        <td><span t-field="order.product_id.display_name"/></td>
                        <td class="text-end"><span t-field="order.amount"/></td>
                        <td><span t-field="order.date_created" t-options="{'widget': 'date'}"/></td>
                        <td class="text-end"><span t-field="order.attachments_count"/></td>
                        <td><span t-field="order.state"/></td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>

    <template id="portal_my_order" name="My Portal Order">
        <t t-call="portal.portal_layout">
            <div class="card o_portal_orders_order" t-att-data-order-id="portal_order.id">
                <div class="card-header">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <t t-if="is_manager and portal_order.state == 'draft'">
                            <button type="button" class="btn btn-success o_portal_orders_action" data-action="approve">Approve</button>
                            <button type="button" class="btn btn-danger o_portal_orders_action" data-action="reject">Reject</button>
                        </t>
                        <button t-if="not is_manager and portal_order.state == 'approved'" type="button"
                                class="btn btn-success o_portal_orders_action" data-action="buy">Buy Product</button>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-3"><strong>Order Number:</strong> <span t-field="portal_order.name"/></div>
                        <div class="col-md-3"><strong>State:</strong> <span t-field="portal_order.state"/></div>
                        <div class="col-md-3"><strong>Date Created:</strong> <span t-field="portal_order.date_created" t-options="{'widget': 'date'}"/></div>
                        <div class="col-md-3"><strong>Picking Date:</strong> <span t-field="portal_order.picking_date"/></div>
                    </div>
                </div>
                <div class="card-body">
                    <h4>User Info</h4>
                    <div class="row g-3 mb-4">
                        <div class="col-md-3"><strong>Name:</strong><div t-field="portal_order.partner_id.name"/></div>
                        <div class="col-md-3"><strong>Email:</strong><div t-field="portal_order.partner_id.email"/></div>
                        <div class="col-md-3"><strong>Company:</strong><div t-field="portal_order.company_id.name"/></div>
                        <div class="col-md-3">
                            <strong>Address:</strong>
                            <div t-field="portal_order.partner_id" t-options="{'widget': 'contact', 'fields': ['address'], 'no_marker': True}"/>
                        </div>
                        <div class="col-md-3"><strong>Phone:</strong><div t-field="portal_order.partner_id.phone"/></div>
                    </div>

                    <h4>Product Info</h4>
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <img t-att-src="image_data_uri(portal_order.product_id.image_128)" t-if="portal_order.product_id.image_128"
                                 class="img-fluid rounded" style="width: 85px; height: 85px;" alt="Product image"/>
                        </div>
                        <div class="col-md-3"><strong>Product Name:</strong><div t-field="portal_order.product_id.name"/></div>
                        <div class="col-md-3"><strong>Product Category:</strong><div t-field="portal_order.product_id.categ_id.name"/></div>
                        <div class="col-md-3">
                            <div t-foreach="portal_order.product_id.product_template_attribute_value_ids" t-as="value">
                                <strong><span t-field="value.attribute_id.name"/>:</strong> <span t-field="value.name"/>
                            </div>
                        </div>
                        <div class="col-md-3"><strong>Supplier:</strong><div t-field="portal_order.supplierinfo_id.partner_id.name"/></div>
                        <div class="col-md-3"><strong>Amount:</strong><div t-field="portal_order.amount"/></div>
                        <div class="col-md-3"><strong>Net Unit Price:</strong><div t-field="portal_order.supplierinfo_id.price"/></div>
                        <div class="col-md-3"><strong>Gross Price:</strong><div t-field="portal_order.gross_price"/></div>
                        <div class="col-md-3"><strong>Applied Tax:</strong><div><span t-field="portal_order.tax"/>%</div></div>
                        <div class="col-md-3"><strong>Taxed Price:</strong><div t-field="portal_order.taxed_price"/></div>
                    </div>

                    <h4>Attachments</h4>
                    <ul>
                        <li t-foreach="portal_order.sudo().attachment_ids" t-as="attachment">
                            <a t-attf-href="/my/portal_orders/#{portal_order.id}/attachment/#{attachment.id}" target="_blank">
                                <strong t-out="attachment.name"/>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </t>
    </template>

</odoo>
