<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="portal_order_view_form" model="ir.ui.view">
        <field name="name">portal.order.form</field>
        <field name="model">portal.order</field>
        <field name="arch" type="xml">
            <form string="Portal Order">
                <header>
                    <button name="%(portal_order_picking_date_wizard_action)d" string="Set Picking Date" type="action"
                            class="btn-primary" groups="base.group_user" invisible="state != 'in_progress'"/>
                    <button name="action_done" string="Done" type="object"
                            class="btn-primary" groups="base.group_user" invisible="state != 'ready_to_pick'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="name != 'New'"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="product_id" readonly="1"/>
                            <field name="supplierinfo_id" readonly="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="tax" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_created"/>
                            <field name="picking_date" readonly="1"/>
                            <field name="purchase_order_id"/>
                            <field name="gross_price"/>
                            <field name="taxed_price"/>
                        </group>
                    </group>
                    <group>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="portal_order_view_list" model="ir.ui.view">
        <field name="name">portal.order.list</field>
        <field name="model">portal.order</field>
        <field name="arch" type="xml">
            <list string="Portal Orders">
                <field name="name"/>
                <field name="user_id"/>
                <field name="product_id"/>
                <field name="amount"/>
                <field name="date_created"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="portal_order_view_search" model="ir.ui.view">
        <field name="name">portal.order.search</field>
        <field name="model">portal.order</field>
        <field name="arch" type="xml">
            <search string="Portal Orders">
                <field name="name"/>
                <field name="user_id"/>
                <field name="product_id"/>
                <filter name="to_process" string="To Process"
                        domain="[('state', 'in', ('in_progress', 'ready_to_pick'))]"/>
                <separator/>
                <filter name="draft" string="Waiting for Approval" domain="[('state', '=', 'draft')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_user" string="Requested By" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="portal_order_action_employee" model="ir.actions.act_window">
        <field name="name">Portal Orders (Employee)</field>
        <field name="res_model">portal.order</field>
        <field name="view_mode">list,form</field>
        <field name="group_ids" eval="[Command.link(ref('portal_orders.group_portal_employee'))]"/>
    </record>

    <record id="portal_order_action_manager" model="ir.actions.act_window">
        <field name="name">Portal Orders (Manager)</field>
        <field name="res_model">portal.order</field>
        <field name="view_mode">list,form</field>
        <field name="group_ids" eval="[Command.link(ref('portal_orders.group_portal_manager'))]"/>
    </record>

    <!-- all orders; the "To Process" filter narrows to those backend users
         handle (in progress, ready to pick up). domain and context are set
         explicitly so an upgrade clears older values. -->
    <record id="portal_order_action_internal" model="ir.actions.act_window">
        <field name="name">Portal Orders</field>
        <field name="res_model">portal.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="portal_order_view_search"/>
        <field name="group_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No portal order yet</p>
            <p>Employees create orders from the portal. Use the "To Process"
               filter to see the orders bought and waiting for a pick-up date.</p>
        </field>
    </record>

    <menuitem id="portal_order_menu_root" name="Portal Orders" sequence="2" groups="base.group_user"
              web_icon="purchase,static/description/icon.png"/>
    <menuitem id="portal_order_menu" name="Portal Orders" parent="portal_order_menu_root"
              action="portal_order_action_internal" sequence="1" groups="base.group_user"/>

</odoo>
