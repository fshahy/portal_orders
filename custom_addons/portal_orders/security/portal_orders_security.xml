<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_portal_orders" model="res.groups.privilege">
        <field name="name">Portal Orders</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_portal_employee" model="res.groups">
        <field name="name">Employee</field>
        <field name="comment">Can place purchase requests from the portal</field>
        <field name="privilege_id" ref="res_groups_privilege_portal_orders"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_portal'))]"/>
    </record>

    <record id="group_portal_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="comment">Can approve or reject purchase requests from the portal</field>
        <field name="privilege_id" ref="res_groups_privilege_portal_orders"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_portal'))]"/>
    </record>

</odoo>
