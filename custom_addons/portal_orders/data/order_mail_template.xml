<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="email_template_portal_order_created" model="mail.template">
        <field name="name">Portal Order: Created</field>
        <field name="model_id" ref="portal_orders.model_portal_order"/>
        <field name="email_from">{{ object.company_id.email_formatted }}</field>
        <!-- use_default_to defaults to True and would send to the requester -->
        <field name="use_default_to" eval="False"/>
        <field name="partner_to">{{ object.env.ref('portal_orders.group_portal_manager').all_user_ids.partner_id.ids }}</field>
        <field name="subject">Portal Order {{ object.name }} by {{ object.user_id.name }}</field>
        <field name="body_html" type="html">
<div>
    <p>Dear manager,</p>
    <p>
        The employee <t t-out="object.user_id.name"/> has requested the
        following product: <t t-out="object.product_id.display_name"/>.
    </p>
    <p>
        Please check the order
        <a t-attf-href="{{ object.get_base_url() }}/my/portal_orders/{{ object.id }}">here</a>
        to approve or reject it.
    </p>
    <p>Regards.</p>
</div>
        </field>
    </record>

    <record id="email_template_portal_order_approved" model="mail.template">
        <field name="name">Portal Order: Approved</field>
        <field name="model_id" ref="portal_orders.model_portal_order"/>
        <field name="email_from">{{ object.company_id.email_formatted }}</field>
        <field name="use_default_to" eval="False"/>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="subject">Portal Order Approved: {{ object.name }}</field>
        <field name="body_html" type="html">
<div>
    <p>Dear <t t-out="object.user_id.name"/>,</p>
    <p>Your manager has approved the order. Please open your order and click on the button "Buy Product":</p>
    <p>
        <a t-attf-href="{{ object.get_base_url() }}/my/portal_orders/{{ object.id }}">here</a>
    </p>
    <p>Regards.</p>
</div>
        </field>
    </record>

    <record id="email_template_portal_order_rejected" model="mail.template">
        <field name="name">Portal Order: Rejected</field>
        <field name="model_id" ref="portal_orders.model_portal_order"/>
        <field name="email_from">{{ object.company_id.email_formatted }}</field>
        <field name="use_default_to" eval="False"/>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="subject">Portal Order Rejected: {{ object.name }}</field>
        <field name="body_html" type="html">
<div>
    <p>Dear <t t-out="object.user_id.name"/>,</p>
    <p>
        Sadly your order was rejected for this month, but you can create a new
        one for the same product or a different one next month.
    </p>
    <p>Regards.</p>
</div>
        </field>
    </record>

    <record id="email_template_portal_order_ready" model="mail.template">
        <field name="name">Portal Order: Ready</field>
        <field name="model_id" ref="portal_orders.model_portal_order"/>
        <field name="email_from">{{ object.company_id.email_formatted }}</field>
        <field name="use_default_to" eval="False"/>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="subject">Portal Order Ready: {{ object.name }}</field>
        <field name="body_html" type="html">
<div>
    <p>Dear <t t-out="object.user_id.name"/>,</p>
    <p>
        Your product <t t-out="object.product_id.display_name"/> from the order
        <t t-out="object.name"/> is ready.
    </p>
    <p>You can pick it up at the office on <t t-out="format_date(object.picking_date)"/>.</p>
    <p>Regards.</p>
</div>
        </field>
    </record>

</odoo>
