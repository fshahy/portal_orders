<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="portal_order_picking_date_wizard_view_form" model="ir.ui.view">
        <field name="name">portal.order.picking.date.wizard.form</field>
        <field name="model">portal.order.picking.date.wizard</field>
        <field name="arch" type="xml">
            <form string="Set Picking Date">
                <group>
                    <field name="order_id" invisible="1"/>
                    <field name="picking_date"/>
                </group>
                <footer>
                    <button string="Set Picking Date" name="action_set_picking_date" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="portal_order_picking_date_wizard_action" model="ir.actions.act_window">
        <field name="name">Set Picking Date</field>
        <field name="res_model">portal.order.picking.date.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="portal_order_picking_date_wizard_view_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="portal_orders.model_portal_order"/>
    </record>

</odoo>
